{
  "schema": 1,
  "supported_targets": ["aarch64-macos"],
  "services": [
    "filesystem_metadata",
    "process_spawn_wait",
    "pipes_and_streams",
    "shell_execution",
    "signal_notification",
    "terminal_detection_and_size",
    "monotonic_clock",
    "environment_lookup",
    "executable_lookup"
  ],
  "process": {
    "shell_fallback": "/bin/sh",
    "command_argument": "-c",
    "stdout_stderr_separate": true,
    "close_parent_pipe_ends_before_wait": true,
    "eof_after_child_closes_writer": true,
    "consume_pipes_before_wait": true,
    "cleanup_on_interrupt_or_timeout": true,
    "inherits_environment": true,
    "inherits_working_directory": true,
    "outcomes": ["exited", "signaled"],
    "errors": ["SpawnFailed", "WaitFailed", "TimedOut", "Interrupted"]
  },
  "native_implementations": [
    "src/io/platform.zig",
    "src/io/process.zig",
    "src/io/signals.zig"
  ]
}
